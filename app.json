{
  "expo": {
    "name": "FLMS",
    "slug": "LabBookingProject",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/flms.png",
    "scheme": "labbookingproject",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSAppTransportSecurity": {
          "NSAllowsArbitraryLoads": true
        },
        "ITSAppUsesNonExemptEncryption": false
      },
      "bundleIdentifier": "com.fpt.labbooking"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/flms.png",
        "backgroundColor": "#FFFFFF"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "package": "com.fpt.labbooking",
      "googleServicesFile": "./google-services.json"
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#ffffff"
        }
      ],
      "expo-router",
      [
        "@react-native-google-signin/google-signin",
        {
          "iosUrlScheme": "com.googleusercontent.apps.317167237519-9e80jt1rdcqkdbane352msd5gfnpti95"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/flms.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#FFF7ED",
          "dark": {
            "backgroundColor": "#FFF7ED"
          }
        }
      ],
      "expo-secure-store",
      "expo-web-browser",
      "react-native-add-calendar-event",
      "expo-asset"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "f44230e2-6516-47d2-9b0f-639a4fef54c9"
      }
    }
  }
}
